venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Raw data files are large — not committed to git
data/raw/*.csv
data/raw/*.json
data/raw/*.zip
data/processed/*.csv
# Exception: harvested deep links are small (49 KB) and cannot be
# regenerated deterministically, so they are tracked for reproducibility
!data/processed/tranco_deeplinks.csv

# Models can be large
models/*.onnx
models/*.pkl
models/*.joblib

# Keep folder structure with .gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep

.env
.DS_Store

# PhishLens v2 build
PhishLens v2/venv/
PhishLens v2/__pycache__/
PhishLens v2/data/raw/
PhishLens v2/data/processed/*.csv
!PhishLens v2/data/processed/tranco_deeplinks.csv
PhishLens v2/models/*.joblib